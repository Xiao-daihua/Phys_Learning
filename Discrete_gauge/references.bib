@article{changTopologicalDefectLines2019a,
  title = {Topological {{Defect Lines}} and {{Renormalization Group Flows}} in {{Two Dimensions}}},
  author = {Chang, Chi-Ming and Lin, Ying-Hsuan and Shao, Shu-Heng and Wang, Yifan and Yin, Xi},
  date = {2019-01},
  journaltitle = {Journal of High Energy Physics},
  shortjournal = {J. High Energ. Phys.},
  volume = {2019},
  number = {1},
  eprint = {1802.04445},
  eprinttype = {arXiv},
  eprintclass = {hep-th},
  pages = {26},
  issn = {1029-8479},
  doi = {10.1007/JHEP01(2019)026},
  url = {http://arxiv.org/abs/1802.04445},
  urldate = {2025-03-03},
  abstract = {We consider topological defect lines (TDLs) in two-dimensional conformal field theories. Generalizing and encompassing both global symmetries and Verlinde lines, TDLs together with their attached defect operators provide models of fusion categories without braiding. We study the crossing relations of TDLs, discuss their relation to the 't Hooft anomaly, and use them to constrain renormalization group flows to either conformal critical points or topological quantum field theories (TQFTs). We show that if certain non-invertible TDLs are preserved along a RG flow, then the vacuum cannot be a non-degenerate gapped state. For various massive flows, we determine the infrared TQFTs completely from the consideration of TDLs together with modular invariance.},
  keywords = {Condensed Matter - Strongly Correlated Electrons,High Energy Physics - Theory},
  file = {/Users/xiaodaihua/Zotero/storage/TWHLQ2K5/Chang 等 - 2019 - Topological Defect Lines and Renormalization Group Flows in Two Dimensions.pdf;/Users/xiaodaihua/Zotero/storage/QAZMT7F7/1802.html}
}
@online{shaoWhatsDoneCannot2024,
  title = {What's {{Done Cannot Be Undone}}: {{TASI Lectures}} on {{Non-Invertible Symmetries}}},
  shorttitle = {What's {{Done Cannot Be Undone}}},
  author = {Shao, Shu-Heng},
  date = {2024-03-30},
  eprint = {2308.00747},
  eprinttype = {arXiv},
  eprintclass = {cond-mat, physics:hep-ph, physics:hep-th},
  doi = {10.48550/arXiv.2308.00747},
  url = {http://arxiv.org/abs/2308.00747},
  urldate = {2024-07-18},
  abstract = {We survey recent developments in a novel kind of generalized global symmetry, the non-invertible symmetry, in diverse spacetime dimensions. We start with several different but related constructions of the non-invertible Kramers-Wannier duality symmetry in the Ising model, and conclude with a new interpretation for the neutral pion decay and other applications. These notes are based on lectures given at the TASI 2023 summer school "Aspects of Symmetry."},
  langid = {american},
  pubstate = {prepublished},
  keywords = {Condensed Matter - Strongly Correlated Electrons,High Energy Physics - Phenomenology,High Energy Physics - Theory,Mathematics - Category Theory,Mathematics - Quantum Algebra},
  file = {/Users/xiaodaihua/Zotero/storage/RVZR7Q3Y/Shao - 2024 - What's Done Cannot Be Undone TASI Lectures on Non.pdf;/Users/xiaodaihua/Zotero/storage/Y8C73QSF/2308.html}
}

@article{collierSolving3dGravity2023,
  title = {Solving 3d {{Gravity}} with {{Virasoro TQFT}}},
  author = {Collier, Scott and Eberhardt, Lorenz and Zhang, Mengyang},
  date = {2023-10-11},
  journaltitle = {SciPost Physics},
  shortjournal = {SciPost Phys.},
  volume = {15},
  number = {4},
  eprint = {2304.13650},
  eprinttype = {arXiv},
  eprintclass = {hep-th},
  pages = {151},
  issn = {2542-4653},
  doi = {10.21468/SciPostPhys.15.4.151},
  url = {http://arxiv.org/abs/2304.13650},
  urldate = {2025-02-22},
  abstract = {We propose a precise reformulation of 3d quantum gravity with negative cosmological constant in terms of a topological quantum field theory based on the quantization of the Teichm\textbackslash "uller space of Riemann surfaces that we refer to as ``Virasoro TQFT.'' This TQFT is similar, but importantly not equivalent, to \$\textbackslash text\{SL\}(2,\textbackslash mathbb\{R\})\$ Chern-Simons theory. This sharpens the folklore that 3d gravity is related to \$\textbackslash text\{SL\}(2,\textbackslash mathbb\{R\})\$ Chern-Simons theory into a precise correspondence, and resolves some well-known issues with this lore at the quantum level. Our proposal is computationally very useful and provides a powerful tool for the further study of 3d gravity. In particular, we explain how together with standard TQFT surgery techniques this leads to a fully algorithmic procedure for the computation of the gravity partition function on a fixed topology exactly in the central charge. Mathematically, the relation leads to many nontrivial conjectures for hyperbolic 3-manifolds, Virasoro conformal blocks and crossing kernels.},
  langid = {american},
  keywords = {High Energy Physics - Theory,Mathematical Physics,Mathematics - Mathematical Physics},
  file = {/Users/xiaodaihua/Zotero/storage/W3288NT4/Collier 等 - 2023 - Solving 3d Gravity with Virasoro TQFT.pdf;/Users/xiaodaihua/Zotero/storage/C7MU2M6H/2304.html}
}


@article{hsiehFermionicMinimalModels2021,
  title = {Fermionic Minimal Models},
  author = {Hsieh, Chang-Tse and Nakayama, Yu and Tachikawa, Yuji},
  date = {2021-05-10},
  journaltitle = {Physical Review Letters},
  shortjournal = {Phys. Rev. Lett.},
